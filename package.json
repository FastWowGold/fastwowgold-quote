  "description": "Tiny client for FastWoWGold's public price quote API, plus WoW gold/silver/copper helpers. Zero dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
